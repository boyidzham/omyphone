#!/bin/bash
# Test stub for notify-send. Records its arguments and PID in $OMYPHONE_STUB_DIR,
# prints an ID for -p, and with -A waits until the test writes an action name to
# $OMYPHONE_STUB_DIR/action, then prints it (like the real notify-send).
python3 -c 'import json, sys; print(json.dumps(sys.argv[1:]))' "$@" >> "$OMYPHONE_STUB_DIR/notify.log"
echo $$ >> "$OMYPHONE_STUB_DIR/notify.pids"
wait_action=0
for arg in "$@"; do
  case "$arg" in
    -p) echo 42 ;;
    -A) wait_action=1 ;;
  esac
done
if [ "$wait_action" = 1 ]; then
  while [ ! -f "$OMYPHONE_STUB_DIR/action" ]; do sleep 0.05; done
  cat "$OMYPHONE_STUB_DIR/action"
  rm -f "$OMYPHONE_STUB_DIR/action"
fi
